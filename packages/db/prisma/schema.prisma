
datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?

  kind   UserKind @default(human) // §9: human or agent principal
  role   UserRole @default(user)  // §10: authorization role
  scopes Json     @default("[]")  // §9: agent capability grants
  quotas Json?                      // §9: rate/spend quotas for agents

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ===== Phase 1 — domain core (§9) =====

enum UserKind {
  human
  agent
}

// §10 human-in-the-loop roles. Approval `route` arrays name these roles;
// `admin` bypasses route membership (never silently — decisions stay audited).
enum UserRole {
  admin
  finance
  procurement
  user
}

// §16.1 — evaluation is config, not a fork (reserved seam).
enum AwardCriterion {
  lcrb
  mearb
  marb
  hrrb
  lowestCost
  bestValue
}

// §9 — how a requirement is sourced.
enum EntityClass {
  catalog
  negotiated
  competitive
}

// §16.1 — publication is opt-in per instance (reserved seam).
enum PublicationState {
  sealed
  published
  redacted
}

// lifecycle/qualification of a Vendor master record.
enum VendorStatus {
  prospective
  active
  watch
  blacklisted
}

// what a Policy encodes. `evaluationCriterion` carries the §9 seam:
// the AwardCriterion + price weight bounds a customer instance sets.
enum PolicyKind {
  threshold
  preferredVendor
  approvalChain
  budgetControl
  evaluationCriterion
  taxRule
}

model CatalogItem {
  id                        String  @id @default(cuid())
  sku                       String  @unique
  name                      String
  category                  String  @default("general")
  unit                      String  @default("ea")
  active                    Boolean @default(true)
  defaultPriceMinor         Int?    // §8.4 money = minorUnits + currencyCode
  defaultCurrencyCode       String  @default("PHP")
  qualifiedVendorIds        String? // JSON list — contractual suppliers
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("catalogItem")
  @@index([category])
  @@index([active])
}

model Vendor {
  id                      String       @id @default(cuid())
  name                    String
  status                  VendorStatus @default(prospective)
  email                   String?
  taxId                   String? // §8.4 EWT/VAT anchor per vendor
  paymentTermsDays        Int?  // net-{n} default
  ratingScore             Int?  // 0..100, our scored model
  qualifiedEntityClass    EntityClass? // how this vendor is typically sourced
  blacklistReason         String?
  contactChannels         Json? // verified addresses/emails (§8.3 outbox)
  // §8.6 beneficiary bank control: a run will not plan an invoice whose
  // vendor has not been verified after the last bank-account change.
  bankAccount          Json?
  bankAccountVerifiedAt DateTime?
  bankAccountChangedAt  DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("vendor")
  @@index([status])
  @@index([name])
}

model Budget {
  id                 String   @id @default(cuid())
  name               String
  costCenter         String
  period             String // e.g. "2026-01"
  currencyCode       String   @default("PHP")
  limitMinor         Int      @default(0)
  committedMinor     Int      @default(0) // POs issued
  spentMinor         Int      @default(0) // paid invoices
  status             String    @default("open")
  updatedAt          DateTime @updatedAt

  @@map("budget")
  @@unique([costCenter, period])
}

model Policy {
  id            String     @id @default(cuid())
  name          String
  kind          PolicyKind
  enabled       Boolean    @default(true)
  version       Int        @default(1)
  supersedesId  String?
  config        Json       // machine-checkable rule payload
  updatedBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("policy")
  @@index([kind, enabled])
}

// Append-only audit trail (§9 constraints). No update/delete path exposed.
model AuditEntry {
  id        String   @id @default(cuid())
  runId     String?  // §7.1 links audit to agent execution
  actorId   String
  actorKind UserKind
  action    String // e.g. "catalog.create", "budget.commit"
  entity    String
  entityId  String?
  inputHash String? // content-addressed payload
  before    Json?
  after     Json?
  at        DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([at])
}

// §9 idempotency: mutations carry an idempotency key; keys resolve to a prior
// outcome so agent retries are safe.
model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  resultJson Json
  createdAt DateTime @default(now())

  @@map("idempotencyKey")
  @@index([key])
}

// ===== Phase 3 — agent skills (§7, §13) =====

enum RunStatus {
  running
  succeeded
  failed
  cancelled
}

/// §7.1 — identity + audit of one agent execution. Every tool call
/// within a run tags this runId for full traceability.
model AgentRun {
  id         String    @id @default(cuid())
  agentId    String    // User.id where kind = agent
  taskId     String?   // parent task, if decomposed by orchestrator
  status     RunStatus @default(running)
  skills     String[]  // which skill bundles were active
  meta       Json?     // runtime metadata (model, tokens, cost)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@map("agentRun")
  @@index([agentId])
  @@index([status])
  @@index([startedAt])
}

/// §13 — transactional outbox for domain events. Written in the same
/// transaction as the domain mutation; a relay publishes to subscribers.
/// Failed deliveries retry (attemptCount/lastError) and dead-letter after
/// EVENT_RELAY_MAX_ATTEMPTS so a poison event cannot block the queue.
model DomainEvent {
  id                String    @id @default(cuid())
  type              String    // e.g. "requisition.approved", "invoice.received"
  entityType        String    // e.g. "Requisition", "Invoice"
  entityId          String
  payload           Json      // event-specific data
  publishedAt       DateTime? // null = unpublished
  attemptCount      Int       @default(0)
  lastError         String?
  deadLetteredAt    DateTime? // null = still retryable
  deadLetterReason  String?
  createdAt         DateTime  @default(now())

  @@map("domainEvent")
  @@index([publishedAt])
  @@index([deadLetteredAt])
  @@index([type])
  @@index([createdAt])
}


// ===== Phase 2 — requisition → PO (§10, §11) =====

enum ReqStatus {
  draft
  submitted
  approved
  rejected
  exception
  cancelled
}

enum ReqLineStatus {
  pending
  approved
  rejected
}

enum PoStatus {
  draft
  issued
  confirmed
  cancelled
}

enum ApprovalStatus {
  pending
  approved
  rejected
  overridden
}

// what gate an approval enforces (§10.1 gate table).
enum ApprovalKind {
  threshold
  budgetOverride
  vendorGate
  policyGate
  poCancellation
}

model Requisition {
  id            String           @id @default(cuid())
  requestNumber String           @unique
  requestedBy   String
  status        ReqStatus        @default(draft)
  costCenter    String
  budgetId      String?
  priority      String           @default("normal")
  note          String?
  submittedAt   DateTime?
  decidedAt     DateTime?
  lines         RequisitionLine[]
  approvals     Approval[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("requisition")
  @@index([status])
  @@index([costCenter])
  @@index([requestedBy])
}

model RequisitionLine {
  id             String        @id @default(cuid())
  requisitionId  String
  requisition    Requisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  lineNo         Int
  sku            String?
  description    String
  quantity       Int
  unit           String        @default("ea")
  unitPriceMinor Int
  currencyCode   String        @default("PHP")
  lineTotalMinor Int
  status         ReqLineStatus @default(pending)

  @@map("requisitionLine")
  @@index([requisitionId])
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  poNumber      String   @unique
  requisitionId String?
  vendorId      String
  status        PoStatus @default(draft)
  currencyCode  String   @default("PHP")
  totalMinor    Int
  terms         Json?
  issuedBy      String
  issuedAt      DateTime?
  lines         PurchaseOrderLine[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("purchaseOrder")
  @@index([status])
  @@index([vendorId])
}

model PurchaseOrderLine {
  id             String  @id @default(cuid())
  poId           String
  po             PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  lineNo         Int
  sku            String?
  description    String
  quantity       Int
  unit           String  @default("ea")
  unitPriceMinor Int
  currencyCode   String  @default("PHP")
  lineTotalMinor Int

  @@map("purchaseOrderLine")
  @@index([poId])
}

model Approval {
  id            String         @id @default(cuid())
  requisitionId String?
  requisition   Requisition?   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  poId          String?
  vendorId      String?
  kind          ApprovalKind
  gateOutcome   String         @default("NEED_APPROVAL")
  route         Json           // ordered assignees/roles
  citations     Json           @default("[]") // policy citations
  status        ApprovalStatus @default(pending)
  decidedBy     String?
  decidedAt     DateTime?
  evidence      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("approval")
  @@index([requisitionId])
  @@index([poId])
  @@index([status])
}

// ===== Phase 4 — invoice intake + tax (§8.2, §8.4) =====

enum IntakeStatus {
  new
  classifying
  extracted
  matched
  exception
  dropped
}

enum InvoiceStatus {
  received
  matched
  exception
  paid
}

// §8.6 approved payment run (hand-off to finance).
enum PaymentRunStatus {
  draft
  approved
  executed
  reconciled
  voided
}

// §8.6 per-supplier payment on a run.
enum PaymentStatus {
  planned
  paid
  dishonored
  rejected
}

// §8.6 approved payment run. amount is deterministic per §9:
// Σ per line (invoice gross + VAT − EWT), computed by the service — the
// agent only composes and rationalizes exceptions.
model PaymentRun {
  id           String         @id @default(cuid())
  runNumber    String         @unique
  status       PaymentRunStatus @default(draft)
  totalMinor   Int
  currencyCode String         @default("PHP")
  notes        Json? // planner notes / rationalization
  createdBy    String
  approvedBy   String?
  approvedAt   DateTime?
  executedBy   String?
  executedAt   DateTime?
  reconciledAt DateTime?
  lines        PaymentRunLine[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("paymentRun")
  @@index([status])
}

// One invoice per line (planned → paid/dishonored/rejected).
model PaymentRunLine {
  id      String       @id @default(cuid())
  runId   String
  run     PaymentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  invoiceId String
  netMinor Int
  status  PaymentStatus @default(planned)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("paymentRunLine")
  @@unique([invoiceId])
  @@index([runId])
}

// §8.2 normalized ingestion queue. One row per document; [channel, contentHash]
// dedupes across channels (email, EIS XML, Peppol/EDI, API).
model IntakeDocument {
  id          String       @id @default(cuid())
  channel     String
  contentHash String
  senderId    String? // verified against Vendor master when known
  raw         Json? // attachments, headers, original payload
  status      IntakeStatus @default(new)
  classified  Json? // document type, vendor hint, amounts (agent or extractor)
  receivedAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("intakeDocument")
  @@unique([channel, contentHash])
  @@index([status])
}

// §9 Invoice: gross before tax, with VAT/EWT computed deterministically by the
// tax engine (§8.4) — never by the agent. Money is minor units.
model Invoice {
  id               String        @id @default(cuid())
  poId             String?
  vendorId         String
  number           String
  amountMinor      Int
  vatMinor         Int           @default(0)
  ewtMinor         Int           @default(0)
  currencyCode     String        @default("PHP")
  taxPolicyVersion String?
  receivedAt       DateTime      @default(now())
  status           InvoiceStatus @default(received)
  matchResult      Json? // 3-way match details (poId, variance, outcome)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("invoice")
  @@unique([vendorId, number])
  @@index([status])
  @@index([poId])
}

// ===== Phase 7 — enterprise identity (§16.2: OIDC/SAML/SCIM) =====

// §16.2 "Identity is the org's": the instance's IdP connection, managed by
// admins through the api (raw better-auth management paths are disabled).
// oidcConfig/samlConfig are JSON blobs owned by @better-auth/sso.
model SsoProvider {
  id             String  @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String
  providerId     String  @unique
  organizationId String?
  domain         String

  @@map("ssoProvider")
}

// SCIM provisioning connection (IdP → aipms user sync). The scimToken is the
// bearer credential the IdP presents to /api/auth/scim/v2/*.
model ScimProvider {
  id             String  @id
  providerId     String  @unique
  scimToken      String  @unique
  organizationId String?

  @@map("scimProvider")
}

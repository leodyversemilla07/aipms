# PostgreSQL used by @workspace/db (Prisma 7 + pg driver adapter).
# Copy this file to .env at the repo root and fill in real values.
# Legacy Postgres URL, e.g. postgresql://user:password@localhost:5432/aipms
DATABASE_URL="postgresql://user:password@localhost:5432/aipms"

# Better Auth (used by @workspace/auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Origin that serves /api/auth/* (web app, or a dedicated API app)
# BETTER_AUTH_URL="http://localhost:3000"
# Public origin of the web app
# APP_URL="http://localhost:3000"
# Extra origins allowed to call the auth API (comma separated)
# AUTH_TRUSTED_ORIGINS=""
# Shared cookie domain for cross-subdomain sessions, e.g. .example.com
# AUTH_COOKIE_DOMAIN=""

# Optional Google OAuth — set both or neither
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# §3 agent drain loop (off by default). When enabled, the intake queue is
# processed unattended on an interval: AGENT_INTERVAL_MS (default 60000) and
# AGENT_BATCH_SIZE (default 25).
# AGENT_AUTORUN=0
# AGENT_INTERVAL_MS=60000
# AGENT_BATCH_SIZE=25

# §16.4 maker/checker demo identities (off by default, non-production):
# seeds maker@demo.aipms / checker@demo.aipms so the web switcher can
# alternate accounts to satisfy the approver-must-differ maker rule.
# AUTH_SEED_DEMO=0

# §3 machine-to-machine access for the eve agent runtime: the service
# endpoint POST /api/service/agent/batch requires this Bearer token, and
# actions under it are audited with actorKind 'agent'.
# Generate with: openssl rand -base64 32
# AIPMS_SERVICE_TOKEN=""
# AIPMS_API_URL="http://localhost:3001"   # used by the eve agent tool

# §16.3 qualified PO signatures (optional — signing is disabled when unset).
# Point AIPMS_SIGNING_KEYS_DIR at a directory of PEM private keys; each file
# name (sans .pem) is a key id. The active key signs new signatures. Mount
# public keys only on verify-only nodes via AIPMS_SIGNING_PUBLIC_KEYS_DIR.
# Keys are ECDSA P-256: openssl ecparam -name prime256v1 -genkey -noout -out purchasing-2026.pem
# AIPMS_SIGNING_KEYS_DIR="./keys"
# AIPMS_SIGNING_ACTIVE_KEY_ID="purchasing-2026"
# AIPMS_SIGNING_PUBLIC_KEYS_DIR=""

# Set to "true" to enable query-level logging via the Prisma client.
# PRISMA_LOG_QUERIES="true"

# ── Single-tenant deployment (docker compose) ────────────────────────────────
# `docker compose up -d --build` runs postgres + api + web + agent. Values in
# a root .env override the compose defaults below.
# BETTER_AUTH_SECRET is REQUIRED in production (openssl rand -base64 32) —
# the compose default is a dev-only placeholder.
# AIPMS_SERVICE_TOKEN must be set on BOTH api and agent so the eve runtime can
# authenticate (openssl rand -base64 32).
#
# POSTGRES_USER="user"
# POSTGRES_PASSWORD="password"
# POSTGRES_DB="aipms"
# POSTGRES_PORT="5432"
# API_PORT="3001"
# WEB_PORT="3000"
# APP_URL="http://localhost:3000"
# AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# AUTH_SEED_DEMO="1"
# AGENT_AUTORUN="0"
# EVENT_RELAY_INTERVAL_MS="1000"
# EVENT_RELAY_MAX_ATTEMPTS="5"
# AIPMS_LLM_KIND="cloud"            # "cloud" (BYO OpenAI-compatible keys) or "offline"
# AIPMS_LLM_ENDPOINT=""             # e.g. https://api.openai.com/v1 (cloud) or http://llm:11434/v1 (offline)
# AIPMS_LLM_MODEL=""                # e.g. gpt-4o-mini (cloud) or llama3.2:3b (offline)
# AIPMS_LLM_API_KEY=""              # cloud key (falls back to OPENAI_API_KEY)
# OPENAI_API_KEY=""                 # cloud key fallback for the eve runtime
# AIPMS_LLM_GATE=""                 # comma-separated policies: residency, retention, no-retention
# AIPMS_LLM_ALLOWED_HOSTS=""        # comma-separated host allowlist for the residency gate
# AIPMS_LLM_CONTEXT_WINDOW="128000" # custom endpoints bypass the model catalog; set the model's context window
#
# Offline / air-gapped agent runtime (zero egress, §16.2.1):
#   1. Start the bundled local model:   docker compose --profile offline up -d
#   2. Pull an open-weight model once:  docker compose --profile offline exec llm ollama pull llama3.2:3b
#   3. Point the agent at it:
#      AIPMS_LLM_KIND="offline"
#      AIPMS_LLM_ENDPOINT="http://llm:11434/v1"
#      AIPMS_LLM_MODEL="llama3.2:3b"
#   4. (Optional) declare the gate policies the instance honors:
#      AIPMS_LLM_GATE="residency,no-retention"
#   The agent refuses to start if the gate is not satisfied (§16.6).
# ── QuickBooks Online connector (§8.5 v1 anchor adapter) ──────────────────
# Intuit app credentials (developer.intuit.com). Leave unset to hide the
# connector UI; the journal export itself works without it.
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
# sandbox (default) or production
QBO_ENVIRONMENT="sandbox"
# Optional — defaults to ${API_URL}/api/erp/qbo/callback
QBO_REDIRECT_URI=""

# ── Agent guardrails (§7.4) ───────────────────────────────────────────────
# Per-agent mutation rate limit (mutations/minute) and in-flight mutation
# concurrency cap enforced by tRPC middleware for machine principals.
AIPMS_AGENT_RATE_LIMIT="60"
AIPMS_AGENT_CONCURRENCY="4"

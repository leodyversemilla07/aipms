{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "AIPMS_SERVICE_TOKEN",
    "CAPACITY_AGENT_BOOTSTRAP_TOKEN",
    "CAPACITY_ALLOW_INSECURE",
    "CAPACITY_BASE_URL",
    "CAPACITY_CONCURRENCY",
    "CAPACITY_MAX_ERROR_RATE",
    "CAPACITY_MAX_P95_MS",
    "CAPACITY_REQUESTS",
    "CAPACITY_TIMEOUT_MS",
    "OPERATIONS_ALLOW_INSECURE",
    "OPERATIONS_API_URL",
    "OPERATIONS_MAX_OBSERVATION_AGE_MS",
    "OPERATIONS_MONITORING_TOKEN",
    "OPERATIONS_TIMEOUT_MS",
    "RELEASE_EVIDENCE_MAX_AGE_DAYS",
    "STAGING_API_URL",
    "STAGING_HTTP_PORT",
    "STAGING_SKIP_HTTP_REDIRECT",
    "STAGING_WEB_URL",
    "STAGING_WORKLOAD_EVIDENCE",
    "STAGING_WORKLOAD_JSON",
    "STAGING_WORKLOAD_MAX_ERROR_RATE",
    "STAGING_WORKLOAD_MAX_P95_MS",
    "TLS_MIN_VALID_DAYS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "db:generate": {
      "dependsOn": ["^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "prisma/**"],
      "outputs": ["src/generated/**"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:deploy": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:reset": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "auth:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
